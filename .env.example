# ---------------------------------------------------------------------------
# Copy this file to ".env" for local development, and set the same values in
# Netlify (Site settings -> Environment variables) for the deployed site.
# ---------------------------------------------------------------------------

# --- Supabase (front end: safe to expose, this is the public "anon" key) ---
# Found in Supabase: Project Settings -> API.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Server-only secrets (used by Netlify Functions; NEVER prefixed VITE_) ---
# The service_role key bypasses row-level security. It lives only on the server.
# Found in Supabase: Project Settings -> API -> service_role (keep secret!).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# The password the admin (Erin) types to unlock the verification dashboard.
# Pick anything; share it only with whoever is verifying on the day.
ADMIN_PASSWORD=change-me-before-the-event
